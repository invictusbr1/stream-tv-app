# Copie estas variáveis para o ambiente do servidor. Nunca coloque chaves no APK ou no GitHub.
JARVIS_PROVIDER=groq
# Opcional: deixe vazio para o Jarvis escolher sozinho um modelo de conversa disponível na conta.
JARVIS_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Alternativa: JARVIS_PROVIDER=gemini e GEMINI_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=
