# Copie este arquivo para ".env" e preencha. São os segredos do seu servidor.

# Código que libera o aplicativo (mínimo 8 caracteres). Sem ele, qualquer um usa.
ACESSO_CODIGO=troque-por-um-codigo-grande

# Chave do painel da central (mínimo 8 caracteres).
CENTRAL_KEY=troque-por-outra-chave-grande

# Token que o aplicativo usa para reportar na central (pode ficar vazio).
CENTRAL_TOKEN=

# Jarvis (opcional).
GROQ_API_KEY=
GEMINI_API_KEY=

# Sincronização de favoritos e histórico (opcional).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Fuso horário e (opcional) origens de outros sites autorizadas na API.
TZ=America/Sao_Paulo
ORIGENS_PERMITIDAS=
