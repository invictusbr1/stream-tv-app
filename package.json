{
  "name": "stream-tv",
  "version": "2.13.48",
  "description": "Conecta TV - catalogo, players e aplicativos (Android, Windows, iPhone)",
  "main": "launcher.js",
  "bin": "launcher.js",
  "scripts": {
    "start": "node launcher.js",
    "build:exe": "pkg . --targets node18-win-x64 --output \"dist/Conecta TV.exe\"",
    "build:central": "pkg central/launcher.js --targets node18-win-x64 --output \"dist/Central Conecta TV.exe\"",
    "test": "node --test playback.test.cjs auto-player.test.cjs library.test.cjs android/catalog.test.cjs personal.test.cjs pwa.test.cjs midia-proxy.test.cjs pipoca-source.test.cjs vidsrc-source.test.cjs fontes-motor.test.cjs avaliador.test.cjs seguranca.test.cjs central/central.test.cjs central/identidade.test.cjs central/titulos.test.cjs central/titulos-problema.test.cjs central/revisor.test.cjs mgeb-source.test.cjs legendas-online.test.cjs central/verificar-midia.test.cjs fenix-source.test.cjs perfis-motor.test.cjs central/perfis.test.cjs central/placar.test.cjs central/cacador-amostras.test.cjs central/fila.test.cjs",
    "start:web": "node server.js",
    "preparar:build": "npm install pkg@5.8.1 --no-save --no-audit --no-fund"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "1.18.1",
    "express": "5.2.1",
    "hls.js": "1.7.3",
    "puppeteer-core": "^23.11.1"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "launcher.js",
      "fontes-motor.js",
      "legendas-online.js",
      "seguranca.js",
      "central-reporter.js",
      "playback-source.js",
      "diagnostico.js",
      "midia-proxy.js",
      "series-source.js",
      "pipoca-source.js",
      "vidsrc-source.js",
      "android/app/src/main/assets/catalog.js",
      "pwa/page.cjs",
      "vixsrc-source.js",
      "baixador.js",
      "perfis-motor.js",
      "perfis-locais.js",
      "listas-tv.js",
      "central/perfis.js",
      "central/placar.js"
    ],
    "assets": [
      "index.html",
      "playback.js",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/hls.js/LICENSE",
      "library.js",
      "auth.js",
      "jarvis.js",
      "acesso.js",
      "legendas.js",
      "android/app/src/main/assets/assistir.html",
      "android/app/src/main/assets/catalog.js",
      "personal.js",
    "diagnostico-controle.mp4",
      "config.local.json",
      ".env.example",
      "pwa/*",
      "fontes.json",
      "perfis.json",
      "perfis-motor.js",
      "perfis-locais.js",
      "listas-tv.js",
      "central/painel.html"
    ]
  }
}





















